{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "riley-clone/section-contract.schema.json",
  "title": "Riley clone section contract",
  "description": "Closed shape of every sections/*.json (checked by extraction/verify_all.py). `source` = provenance (what DOM/component it is); `semantic` = AI-facing taxonomy. They are separate on purpose: wrapper/class naming never decides the taxonomy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "registryId", "version", "category", "purpose", "iaSectionIds", "implementedBy", "source", "semantic", "retrievalEligible", "generatedAssetRoles", "variants", "contentContract", "constraints", "motion", "responsive", "evidence", "notes"],
  "definitions": {
    "cite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cite", "anchor"],
      "properties": {
        "cite": {"type": "string", "pattern": "^[^:/][^:]*:\\d+(-\\d+)?$"},
        "anchor": {"type": "string", "minLength": 1}
      }
    },
    "cites": {"type": "array", "items": {"$ref": "#/definitions/cite"}}
  },
  "properties": {
    "$schema": {"const": "riley-design-tokens/section"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "registryId": {"type": "string", "pattern": "^section\\.[a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "category": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 10},
    "iaSectionIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "implementedBy": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/cite"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tag", "file", "lines"],
      "properties": {
        "id": {"type": "string", "pattern": "^src:"},
        "tag": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
        "file": {"type": "string", "minLength": 1},
        "lines": {"type": "string", "pattern": "^\\d+-\\d+$"}
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category"],
      "properties": {
        "id": {"type": "string"},
        "category": {"enum": ["SHELL", "HERO", "PROOF", "FEATURES", "CONVERSION", "SUPPORT", "EDITORIAL", "NAVIGATION", "LEGAL", "ERROR", "UTILITY"]}
      }
    },
    "retrievalEligible": {"type": "boolean"},
    "retrievalReason": {"type": "string", "minLength": 30},
    "placement": {"enum": ["global-overlay"]},
    "generatedAssetRoles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "variants": {"type": "object", "additionalProperties": {"type": "string"}},
    "contentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaRef", "copyBudget", "budgetRule"],
      "properties": {
        "schemaRef": {"oneOf": [{"type": "string", "pattern": "^#/definitions/node_"}, {"type": "object", "additionalProperties": {"type": "string", "pattern": "^#/definitions/node_"}}]},
        "copyBudget": {"type": "object"},
        "budgetRule": {"type": "string", "minLength": 10}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onePerPage"],
      "properties": {"onePerPage": {"type": "boolean"}, "repeatable": {"type": "boolean"}}
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "motionRoles", "reducedMotionFallback", "reducedMotionFallbackStatus"],
      "properties": {
        "pattern": {"type": "string"},
        "motionRoles": {"type": "array", "items": {"type": "string"}},
        "reducedMotionFallback": {"type": "string", "minLength": 1},
        "reducedMotionFallbackStatus": {"type": "string"}
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materiallyDifferent", "rules"],
      "properties": {
        "materiallyDifferent": {"type": "boolean"},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "changes", "evidence"],
            "properties": {
              "query": {"type": "string", "minLength": 1},
              "changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "evidence": {"$ref": "#/definitions/cites"}
            }
          }
        }
      }
    },
    "evidence": {"$ref": "#/definitions/cites"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "if": {"properties": {"retrievalEligible": {"const": false}}},
  "then": {"required": ["retrievalReason"]}
}
