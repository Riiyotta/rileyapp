{
  "pageSpecVersion": "2.0.0",
  "page": {
    "route": "/blog/health",
    "title": "Health - Blog | Riley",
    "template": "blog-category",
    "mode": "clone",
    "theme": "riley-light"
  },
  "nodes": [
    {
      "type": "site-header",
      "variant": "standalone",
      "content": {
        "logo": {
          "assetRole": "brand-wordmark",
          "assetRef": "/assets/wordmark.svg",
          "alt": "Riley logo"
        },
        "navItems": [
          {
            "label": "Blog"
          },
          {
            "label": "What's New?"
          }
        ],
        "cta": {
          "label": "Get Started For Free",
          "assetRole": "app-store-onelink"
        },
        "mobileCta": {
          "label": "Try For $0",
          "assetRole": "app-store-onelink"
        }
      },
      "motion": {
        "pattern": "header-load-and-sticky",
        "reducedMotionFallback": "Render header and nav fully visible on load (no fade/stagger); keep the fixed-after-scroll switch but without transition; open the mobile menu without the slide."
      }
    },
    {
      "type": "blog-index-hero",
      "content": {
        "mascot": {
          "assetRole": "mascot-illustration",
          "assetRef": "/assets/blog/icons/blogmascot.svg",
          "alt": "Riley Mascot"
        },
        "heading": "Riley Articles",
        "subtitle": "Helpful articles with all the information you need to raise happy, healthy children!",
        "illustration": {
          "assetRole": "brand-illustration",
          "assetRef": "/assets/blog/icons/books.svg",
          "alt": "Book icon"
        }
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-required: no section-level motion (primitive hover/press colour changes only)."
      }
    },
    {
      "type": "blog-search",
      "content": {
        "placeholder": "Search blog article...",
        "emptyLabel": "No results found"
      },
      "motion": {
        "pattern": "search-dropdown-fade",
        "reducedMotionFallback": "Show the results dropdown instantly (no 0.2s fade)."
      }
    },
    {
      "type": "blog-category-tabs",
      "content": {
        "tabs": [
          {
            "label": "All",
            "assetRole": "internal-route"
          },
          {
            "label": "Feeding",
            "assetRole": "internal-route"
          },
          {
            "label": "Pregnancy",
            "assetRole": "internal-route"
          },
          {
            "label": "Sleep",
            "assetRole": "internal-route"
          },
          {
            "label": "Health",
            "assetRole": "internal-route"
          },
          {
            "label": "Development",
            "assetRole": "internal-route"
          },
          {
            "label": "News",
            "assetRole": "internal-route"
          },
          {
            "label": "Authors",
            "assetRole": "internal-route"
          }
        ],
        "activeIndex": 4
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-required: no section-level motion (primitive hover/press colour changes only)."
      }
    },
    {
      "type": "blog-pagination",
      "content": {
        "prevLabel": "Prev",
        "nextLabel": "Next",
        "pageLabel": "Page",
        "page": 1,
        "totalPages": 1
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-required: no section-level motion (primitive hover/press colour changes only)."
      }
    },
    {
      "type": "final-cta",
      "content": {
        "heading": "We are raising a generation of confident parents.",
        "cta": {
          "label": "Get support that gets you",
          "assetRole": "app-store-onelink"
        },
        "background": {
          "assetRole": "decorative-cloud",
          "assetRef": "/assets/background-clouds(1).svg"
        },
        "mascots": {
          "assetRole": "mascot-illustration",
          "assetRef": "/assets/mascots.svg"
        }
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-required: no section-level motion (primitive hover/press colour changes only)."
      }
    },
    {
      "type": "site-footer",
      "content": {
        "newsletter": {
          "prompt": "Stay in the loop with Riley's newsletter.",
          "placeholder": "Email",
          "submitLabel": "Sign up",
          "assetRole": "newsletter-endpoint"
        },
        "linkColumns": [
          [
            {
              "label": "Blog",
              "assetRole": "internal-route"
            },
            {
              "label": "Pricing",
              "assetRole": "internal-route"
            },
            {
              "label": "Editorial Process",
              "assetRole": "internal-route"
            }
          ],
          [
            {
              "label": "Privacy Policy",
              "assetRole": "internal-route"
            },
            {
              "label": "Terms of Service",
              "assetRole": "internal-route"
            },
            {
              "label": "Support",
              "assetRole": "internal-route"
            }
          ]
        ],
        "app": {
          "heading": "Get the App",
          "badge": {
            "assetRole": "store-badge",
            "assetRef": "/assets/icons/app-store-badge.svg",
            "alt": "Download on the App Store"
          },
          "assetRole": "app-store-onelink"
        },
        "logo": {
          "assetRole": "brand-wordmark",
          "assetRef": "/assets/icons/footer-logo.svg"
        },
        "copyright": "© 2025 Riley"
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-required: no section-level motion (primitive hover/press colour changes only)."
      }
    }
  ],
  "overlays": [
    {
      "type": "cookie-consent",
      "content": {
        "message": "By using this site, you accept cookies for analytics.",
        "learnMore": {
          "label": "Learn more",
          "assetRole": "internal-route"
        },
        "acceptLabel": "OK"
      },
      "motion": {
        "pattern": "static",
        "reducedMotionFallback": "none-required: no section-level motion (primitive hover/press colour changes only)."
      }
    }
  ]
}
